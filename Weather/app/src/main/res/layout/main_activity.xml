<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fon"
    android:padding="16dp">

    <TextView
        android:id="@+id/selectedCityTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="10dp"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <Button
        android:id="@+id/chooseCityButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/selectedCityTextView"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:text="Choose City"
        android:textColor="#000000"/>

    <EditText
        android:id="@+id/enterCityEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/chooseCityButton"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:hint="Enter City"
        android:textColorHint="#FFFFFF"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FFFFFF"
        android:visibility="gone" />

    <Button
        android:id="@+id/getWeatherButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/enterCityEditText"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:text="Change City"
        android:textColor="#000000"
        android:visibility="gone" />

    <TextView
        android:id="@+id/currentWeatherTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/getWeatherButton"
        android:layout_centerHorizontal="true"
        android:paddingTop="20dp"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/currentWeatherTextViewWeather"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/getWeatherButton"
        android:layout_centerHorizontal="true"
        android:paddingTop="50dp"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/currentWeatherTextView"
        android:layout_marginTop="45dp"
        android:scrollbarThumbVertical="@color/white"
        android:scrollbarSize="3dp">

        <LinearLayout
            android:id="@+id/hourly_weather_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</RelativeLayout>
